# What the screens SHOW. "true" renders typed sample data (clearly labelled). "false" reads the live
# record from the Envio indexer (INDEXER_GRAPHQL_URL below).
NEXT_PUBLIC_SAMPLE_DATA=true

# What a tap DOES. "true" = real email sign-in (Privy) and real transactions on Monad testnet with
# sponsored gas. Needs the keys below and deployed contracts (bun run sync:deployment).
NEXT_PUBLIC_CHAIN_MODE=false

# Where the source code lives (used by the "Fair by design" links).
NEXT_PUBLIC_REPO_URL=https://github.com/alibarmonster/jagomoko

# --- Chain mode (NEXT_PUBLIC_CHAIN_MODE=true) --------------------------------

# Privy: dashboard.privy.io -> your app -> Settings -> Basics.
# The app id is public (it ships to the browser); the secret stays on the server.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Pimlico (bundler + paymaster = sponsored gas): dashboard.pimlico.io -> API keys.
# Server only: the browser talks to /api/aa, which adds this key.
PIMLICO_API_KEY=
# Optional: paste the full "Monad Testnet" URL from the Pimlico dashboard (RPC URLs) instead of the key.
PIMLICO_RPC_URL=
# Optional: pin a sponsorship policy (spend limits) from the Pimlico dashboard. Set on the server, so
# the browser cannot choose another one.
PIMLICO_SPONSORSHIP_POLICY_ID=

# Optional. A private Monad testnet RPC endpoint (e.g. Quicknode). Server only: the
# browser reads through /api/rpc. Falls back to the public https://testnet-rpc.monad.xyz.
MONAD_RPC_URL=

# The Envio indexer's GraphQL endpoint. Server only: the browser reads through our /api routes.
# Local `envio dev`: http://localhost:8080/v1/graphql with the dev secret "testing".
# Envio Cloud: use its public endpoint URL and leave the secret empty.
INDEXER_GRAPHQL_URL=
INDEXER_GRAPHQL_SECRET=

# --- Contract v2: tips from other chains ---
# Optional. A private Sepolia RPC for /api/tip-quote (the ETH price and LayerZero fee). Server only.
# Falls back to https://ethereum-sepolia-rpc.publicnode.com.
SEPOLIA_RPC_URL=
# Optional. The public address of this site, for the tip QR on the stream overlay (viewers' phones
# must reach it). Falls back to the address OBS opened the overlay with.
NEXT_PUBLIC_SITE_URL=
