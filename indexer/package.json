{
  "name": "streamquest-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "envio codegen",
    "codegen:local": "envio codegen --config config.local.yaml",
    "dev": "envio dev",
    "dev:local": "envio dev --config config.local.yaml",
    "start": "envio start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --test-timeout=20000",
    "sync:deployment": "node scripts/sync-deployment.mjs",
    "dev:wsl": "wsl bash scripts/wsl-dev.sh",
    "test:e2e": "ENVIO_E2E=1 vitest run --test-timeout=120000 test/e2e.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "6.0.3",
    "viem": "2.57.2",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "envio": "3.12.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
