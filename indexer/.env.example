# Copy to .env (never commit .env). All Envio variables must use the ENVIO_ prefix.

# HyperSync access token for Monad testnet: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Deployed contract addresses (contracts/deployments/10143.json)
ENVIO_CREATOR_REGISTRY=
ENVIO_CHARACTER=
ENVIO_SPLIT_VAULT=
ENVIO_JURY=
ENVIO_QUEST_ESCROW=
ENVIO_PREDICTION_BATTLE=
ENVIO_COMMUNITY_TREASURY=

# Local anvil RPC used by config.local.yaml
ENVIO_LOCAL_RPC_URL=http://127.0.0.1:8545

# Self-hosting: Hasura must never run with the default admin secret in public.
# Set a long random HASURA_GRAPHQL_ADMIN_SECRET, keep Postgres off the public
# network, and expose only the read-only GraphQL endpoint to the frontend.
